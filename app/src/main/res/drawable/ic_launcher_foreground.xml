                android:startX="14"
                android:startY="14"
                android:endX="94"
                android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF833AB4"/>
                <item android:offset="0.5" android:color="#FFFD1D1D"/>
                <item android:offset="1.0" android:color="#FFFCB045"/>
            </gradient>
        </aapt:attr>
    </path>

